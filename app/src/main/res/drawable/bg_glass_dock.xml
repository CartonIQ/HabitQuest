<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dock_fill" />
            <stroke android:width="3dp" android:color="@color/dock_glow" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/dock_stroke" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
